{
  "version": "0.4",
  "title": "RP Motorcycles Services",
  "type": "page",
  "content": [
    {
      "id": "hero",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 80px 40px 60px; text-align: center;\">\n<h1 style=\"color: #fff; font-size: 72px; font-weight: 900; margin-bottom: 20px; font-family: 'Outfit', Inter, sans-serif;\">Our Services</h1>\n<div style=\"display: flex; justify-content: center; gap: 16px; margin-bottom: 30px;\"><div style=\"width: 64px; height: 1px; background: linear-gradient(to right, transparent, #0085FF80);\"></div><div style=\"width: 8px; height: 8px; background: #0085FF; border-radius: 50%;\"></div><div style=\"width: 64px; height: 1px; background: linear-gradient(to left, transparent, #0085FF80);\"></div></div>\n<p style=\"color: #d1d5db; font-size: 20px; line-height: 1.7; max-width: 800px; margin: 0 auto;\">From routine maintenance to complete engine rebuilds, RP Motorcycles offers comprehensive motorcycle services. Our experienced technicians handle all makes and models with <strong style=\"color: #fff;\">precision and care</strong>.</p>\n</div>"
      }
    },
    {
      "id": "trust-badges",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 0 40px 60px; display: flex; justify-content: center; gap: 24px; flex-wrap: wrap;\">\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 16px; padding: 20px 28px; display: flex; align-items: center; gap: 16px;\"><span style=\"color: #0085FF; font-size: 28px;\">\u2605</span><div><strong style=\"color: #fff; font-size: 18px; display: block;\">Expert Technicians</strong><span style=\"color: #9ca3af; font-size: 14px;\">Certified Professionals</span></div></div>\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 16px; padding: 20px 28px; display: flex; align-items: center; gap: 16px;\"><span style=\"color: #22c55e; font-size: 28px;\">\u2713</span><div><strong style=\"color: #fff; font-size: 18px; display: block;\">Quality Guaranteed</strong><span style=\"color: #9ca3af; font-size: 14px;\">Workmanship Warranty</span></div></div>\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 16px; padding: 20px 28px; display: flex; align-items: center; gap: 16px;\"><span style=\"color: #a855f7; font-size: 28px;\">\ud83d\udc65</span><div><strong style=\"color: #fff; font-size: 18px; display: block;\">All Makes & Models</strong><span style=\"color: #9ca3af; font-size: 14px;\">Universal Expertise</span></div></div>\n</div>"
      }
    },
    {
      "id": "services-1",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 0 40px;\">\n<div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;\">\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #0085FF 20%, #0085FF 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/0085FF/FFFFFF/png?text=Motorcycle+Repair\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\ud83d\udd27</div><div><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Core Mechanical Services</h3><p style=\"color: #9ca3af; font-size: 16px;\">Essential maintenance and repairs to keep your motorcycle running smoothly</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 General repair & servicing</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Full motorcycle servicing</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Oil & filter changes</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Spark plug replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Air filter cleaning</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fuel filter replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Coolant flush & refill</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Brake fluid replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Chain cleaning</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Belt & shaft servicing</span></div></div></div>\n\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #A855F7 20%, #A855F7 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/A855F7/FFFFFF/png?text=Diagnostics\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\ud83e\udde0</div><div><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Diagnostics & Troubleshooting</h3><p style=\"color: #9ca3af; font-size: 16px;\">Advanced diagnostic services to identify and resolve issues</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Full diagnostic checks (manual & electronic)</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fault finding (engine, electrical, fuel system)</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Performance issues analysis</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Pre-purchase inspections</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Roadworthy inspections</span></div></div></div>\n</div>\n</div>"
      }
    },
    {
      "id": "services-2",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 28px 40px;\">\n<div style=\"background: #0d1117; border: 1px solid #f9731640; border-radius: 24px; overflow: hidden; box-shadow: 0 0 40px rgba(0,133,255,0.08);\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #F97316 20%, #F97316 80%, transparent);\"></div><img src=\"https://placehold.co/1200x400/F97316/FFFFFF/png?text=Engine+Services\" style=\"width: 100%; height: 220px; object-fit: cover;\"><div style=\"padding: 30px 40px 40px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\u2699\ufe0f</div><div><div style=\"display: flex; align-items: center; gap: 16px;\"><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Engine Services</h3><span style=\"background: linear-gradient(90deg, #0085FF, #0066CC); color: white; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: bold;\">POPULAR</span></div><p style=\"color: #9ca3af; font-size: 16px;\">Complete engine repair, rebuild, and performance tuning</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;\"><div><h4 style=\"color: #6b7280; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 16px; font-weight: 700;\">\u25cf Repairs</h4><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Engine fault diagnosis</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Top-end repairs</span><span style=\"color: #d1d5db; font-size: 15px; display: block;\">\u2713 Bottom-end repairs</span></div><div><h4 style=\"color: #6b7280; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 16px; font-weight: 700;\">\u25cf Rebuilds & Overhauls</h4><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Full engine rebuild</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Engine overhaul</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Cylinder head reconditioning</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Valve adjustment/replacement</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Piston & ring replacement</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Crankshaft repair</span><span style=\"color: #d1d5db; font-size: 15px; display: block;\">\u2713 Gasket & seal replacement</span></div><div><h4 style=\"color: #6b7280; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 16px; font-weight: 700;\">\u25cf Performance</h4><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Engine tuning</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 Performance builds</span><span style=\"color: #d1d5db; font-size: 15px; display: block; margin-bottom: 10px;\">\u2713 High-performance cams</span><span style=\"color: #d1d5db; font-size: 15px; display: block;\">\u2713 Carburetor tuning/jetting</span></div></div></div></div>\n</div>"
      }
    },
    {
      "id": "services-3",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 0 40px;\">\n<div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;\">\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #EAB308 20%, #EAB308 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/EAB308/000000/png?text=Electrical+Services\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\u26a1</div><div><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Electrical Services</h3><p style=\"color: #9ca3af; font-size: 16px;\">Complete electrical system diagnosis and repair</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Battery testing & replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Charging system repairs</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Starter motor repairs</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Wiring repairs & rewiring</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Lighting installation & repair</span></div></div></div>\n\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #22C55E 20%, #22C55E 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/22C55E/FFFFFF/png?text=Fuel+System\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\u26fd</div><div><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Fuel System Services</h3><p style=\"color: #9ca3af; font-size: 16px;\">Fuel system maintenance, cleaning, and repair</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Carburetor cleaning & rebuild</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fuel injector cleaning</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fuel pump repair/replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fuel line replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Tank cleaning (rust removal)</span></div></div></div>\n</div>\n</div>"
      }
    },
    {
      "id": "services-4",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 28px 40px;\">\n<div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;\">\n<div style=\"background: #0d1117; border: 1px solid #ef444440; border-radius: 24px; overflow: hidden; box-shadow: 0 0 40px rgba(0,133,255,0.08);\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #EF4444 20%, #EF4444 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/EF4444/FFFFFF/png?text=Brakes+Safety\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\ud83d\udee1\ufe0f</div><div><div style=\"display: flex; align-items: center; gap: 16px;\"><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Brakes & Safety</h3><span style=\"background: linear-gradient(90deg, #0085FF, #0066CC); color: white; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: bold;\">POPULAR</span></div><p style=\"color: #9ca3af; font-size: 16px;\">Critical brake system services for your safety</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Brake pad replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Brake disc replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Brake caliper rebuild</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Brake bleeding</span></div></div></div>\n\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #6366F1 20%, #6366F1 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/6366F1/FFFFFF/png?text=Suspension\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\ud83d\udcca</div><div><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Suspension & Handling</h3><p style=\"color: #9ca3af; font-size: 16px;\">Optimize your ride quality and handling</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fork seal replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Fork rebuilds</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Shock absorber replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Suspension tuning</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Steering head bearing replacement</span></div></div></div>\n</div>\n</div>"
