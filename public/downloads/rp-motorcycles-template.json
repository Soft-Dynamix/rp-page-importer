    {
      "id": "services-5",
      "elType": "widget",
      "widgetType": "text-editor",
      "settings": {
        "editor": "<div style=\"background: #080c14; padding: 0 40px;\">\n<div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;\">\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #64748B 20%, #64748B 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/64748B/FFFFFF/png?text=Wheels+Tyres\" style=\"width: 100%; height: 200px; object-fit: cover;\"><div style=\"padding: 30px 35px 35px; margin-top: -70px;\"><div style=\"display: flex; align-items: start; gap: 24px;\"><div style=\"width: 64px; height: 64px; background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05)); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px;\">\u2b55</div><div><h3 style=\"color: #fff; font-size: 26px; font-weight: 700; margin: 8px 0;\">Wheels & Tyres</h3><p style=\"color: #9ca3af; font-size: 16px;\">Complete wheel and tyre services</p></div></div><div style=\"height: 1px; background: linear-gradient(to right, transparent, #ffffff20, transparent); margin: 24px 0;\"></div><div style=\"display: grid; gap: 12px;\"><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Tyre fitting & replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Tube replacement</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Wheel balancing</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Spoke tightening & alignment</span><span style=\"color: #d1d5db; font-size: 15px;\">\u2713 Bearing replacement</span></div></div></div>\n\n<div style=\"background: #0d1117; border: 1px solid #1e293b; border-radius: 24px; overflow: hidden;\"><div style=\"height: 4px; background: linear-gradient(90deg, transparent, #10B981 20%, #10B981 80%, transparent);\"></div><img src=\"https://placehold.co/800x400/10B981/FFFFFF/png?text=Transmission\" style=\"width: 100%; he